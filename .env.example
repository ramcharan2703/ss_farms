# =============================================================================
# SS FARMS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your secret values.
# NEVER commit the actual .env file to Git!
# =============================================================================

# Django Security
DEBUG=False
SECRET_KEY=your-secure-50-character-random-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,ss-farms.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://ss-farms.onrender.com
ADMIN_URL_PATH=admin/

# PostgreSQL / Aiven Database Connection
# Format: postgresql://username:password@hostname:port/database_name?sslmode=require
DATABASE_URL=
DB_SSL_REQUIRE=True

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact Email Dispatch (Resend HTTPS API)
# Generate your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=SS Farms <onboarding@resend.dev>
CONTACT_NOTIFICATION_EMAIL=ssfarmswanaparthy@gmail.com

# Optional: Automatic Superuser Provisioning (used by build.sh on deployment)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=ssfarmswanaparthy@gmail.com
DJANGO_SUPERUSER_PASSWORD=your-secure-superuser-password-here

# Business WhatsApp Phone Number (Country Code + 10 digits without + or spaces)
WHATSAPP_NUMBER=918790733189
